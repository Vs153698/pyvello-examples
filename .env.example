# Pyvello API Configuration
# Place this .env file in your project root or working directory.
# Pyvello automatically discovers .env files recursively upwards from any subfolder.

# Primary LLM Provider API Key (OpenRouter, OpenAI, Anthropic, or Google Gemini)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Direct Provider Keys
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom Port or Host
# PORT=8000
